# ==============================================================================
# MEDIFLOW - Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
APP_URL=http://localhost:3000

# ── Email (Nodemailer SMTP) ─────────────────────────────────────────────────────
# If SMTP credentials are not set, MEDIFLOW runs in safe Development Simulation Mode.
# Emails are logged to console and email_logs.json but not delivered.
#
# Gmail setup: enable 2FA → App Passwords → generate 16-char App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="MEDIFLOW Hospital" <noreply@mediflow.local>

# Medical staff notification email (receives new prescription alerts)
STAFF_NOTIFICATION_EMAIL=pharmacy@mediflow.local

# ── Payment (UPI / Razorpay) ───────────────────────────────────────────────────
# If Razorpay keys are not set, MEDIFLOW generates direct UPI deep-links
# and QR codes (mock mode). No actual gateway is used.
#
# Production setup:
#   1. Create a Razorpay account at https://razorpay.com
#   2. Get Key ID and Key Secret from Dashboard → Settings → API Keys
#   3. Set up a webhook at Dashboard → Settings → Webhooks
#      URL: https://your-domain.com/api/payments/verify
#      Events: payment.captured, payment.failed
#      Secret: use a strong random string as RAZORPAY_WEBHOOK_SECRET

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# UPI Merchant VPA (Virtual Payment Address)
# This is the UPI ID where payments are received
# Examples: merchant@okicici, hospital@ybl, pharmacy@paytm
UPI_VPA=mediflow@upi
